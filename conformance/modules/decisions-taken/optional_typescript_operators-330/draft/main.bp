//// Decision 330 — `?T` is read with TypeScript's operators and has no methods; `result` goes; a type declared in a type is its associated type.

import {io.terminal} from "std";
import {Json} from "json";
import {decode} from "yaml";

pub type Page {
    // `Meta` is declared in `Page`'s body, so it is `Page`'s associated type.
    pub type Meta(title: string, summary: ?string, firstTag: ?string)

    pub fn read(doc: Json) -> Page.Meta {
        val tags: ?Json[] = doc.field("tags")?.items();
        return Page.Meta(
            title: doc.field("title")?.str() ?? "untitled",
            summary: doc.field("summary")?.str(),
            firstTag: tags?.[0]?.str(),
        );
    }
}

fn fallback(present: bool) -> ?fn(key: string) -> string {
    return if (present)
        fn(key: string) -> string {
            return "no " + key;
        }
    else
        null;
}

pub fn main() -> void {
    val parsed = decode("title: Notes\ntags: [yaml, json]\n");
    terminal.print(parsed.isOk());
    val meta = parsed
        .map({ doc -> Page.read(doc) })
        .unwrapOr(Page.Meta(title: "untitled", summary: null, firstTag: null));
    terminal.print(meta.title);
    terminal.print(meta.summary ?? fallback(true)?.("summary") ?? "");
    terminal.print(fallback(false)?.("summary") ?? "no fallback");
    terminal.print(meta.firstTag!);
    terminal.print((meta.summary ?? "") == "" || meta.title == "");
}
